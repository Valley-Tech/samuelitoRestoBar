# Variables de SamuelitoBot. Las marcadas (v3.5) son NUEVAS y OPCIONALES:
# si no las pones, el bot usa los valores que ya estaban en el código.

# ---- Meta / WhatsApp ---------------------------------------------------------
WEBHOOK_VERIFY_TOKEN=
API_TOKEN=
BUSINESS_PHONE=                 # phone_number_id del número de Samuelito
API_VERSION=v23.0
BASE_URL=https://graph.facebook.com
APP_SECRET=
PORT=3000
PRIVATE_KEY=                    # clave privada de los Flows
PASSPHRASE=

# ---- CRM ValleyTech --------------------------------------------------------------
CRM_MODE=                       # mirror o gateway
CRM_BASE_URL=
CRM_API_KEY=
CRM_SIGNING_SECRET=
CRM_PHONE_NUMBER_ID=

# ---- v3.5 · Catálogo, Flows y horario (opcionales) -------------------------------
CATALOG_ID=                     # por defecto 899362489478649
FLOW_ID_PEDIDO=                 # por defecto 1667286921657383
FLOW_ID_RESERVA=                # por defecto 1111929481300178
FLOW_ID_ENCUESTA=               # por defecto 1847588183274663
HORA_APERTURA=12:00             # turno del chatbot (hora Colombia); la bienvenida sale 1 vez por turno
HORA_CIERRE=22:00
NOTIFY_NUMBERS=                 # por defecto 573137517489,573006342114 (avisos de pedido y reserva)
DOMICILIO_VALOR=3000
RECORDATORIO_PEDIDO_MIN=5       # recordar el pedido sin terminar cada 5 min…
RECORDATORIO_PEDIDO_MAX=2       # …máximo 2 veces (0 = no recordar)
ADICIONAL_MINUTOS=60            # carrito dentro de 60 min tras llenar el Flow → se ofrece como ADICIONAL
BARRIL_SOLO_DOMINGO=true        # Asados al Barril solo los domingos
SOLO_CON_FOTO=true              # carrusel/tarjeta solo con productos con foto (docs/catalogo-meta-samuelito.csv)
VERIFICAR_FOTOS=true            # además revisa en línea que cada foto exista
FOTO_GENERICA=                  # nombre de la imagen genérica de Loggro (por defecto 69d9062e681205cd21e4)
TARJETAS_CARRUSEL=true          # false → 2 a 10 platos van en lista de productos
NO_RESPONDER_A=                 # números del personal a los que el bot no responde: 57300...,57311...

# ---- Loggro, Wompi, Google Sheets, AWS (sin cambios) ------------------------------
LOGGRO_API_KEY=
URL_BASE_WOMPI=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
SPREADSHEETID_PEDIDO=
SPREADSHEETID_RESERVA=
SPREADSHEETID_SURVEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
